  @@index([organizationId, userId, kind, createdAt])
  @@map("base_notes")
}

// ============================================================
// JORNADA C.O.R.E. — modelo transversal (Spec Jornada · Mariana)
// 9-box nasce em O (potencial), ganha desempenho em R e é lido em E.
// Causa raiz aceita múltiplas causas. PDI é versionado por ciclo.
// ============================================================

enum NineBoxLevel {
  baixo
  medio
  alto
}

enum NineBoxStage {
  organizacao
  resultado
  evolucao
}

model NineBoxEntry {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  cycleId        String        @map("cycle_id") @db.Uuid
  membershipId   String        @map("membership_id") @db.Uuid
  subjectUserId  String?       @map("subject_user_id") @db.Uuid
  subjectLabel   String?       @map("subject_label")
  stage          NineBoxStage  @default(organizacao)
  potential      NineBoxLevel?
  performance    NineBoxLevel?
  notes          String?
  createdBy      String?       @map("created_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([cycleId, membershipId, stage])
  @@index([organizationId, cycleId])
  @@map("nine_box_entries")
}

enum RootCauseCategory {
  comportamental
  processo
  dado
  estrutural
  outro
}

model RootCause {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  cycleId        String?           @map("cycle_id") @db.Uuid
  pdiId          String?           @map("pdi_id") @db.Uuid
  category       RootCauseCategory @default(outro)
  description    String
  createdBy      String?           @map("created_by") @db.Uuid
  createdAt      DateTime          @default(now()) @map("created_at")

  profile Profile? @relation("ProfileRootCauses", fields: [createdBy], references: [id], onDelete: SetNull)
  pdi Pdi? @relation(fields: [pdiId], references: [id], onDelete: Cascade)

  @@index([organizationId, cycleId])
  @@index([pdiId])

  @@map("root_causes")
}

model CycleOkr {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  cycleId        String   @map("cycle_id") @db.Uuid
   objective      String
  plan90         Json?    @map("plan_90")
  linkedGoalId   String?  @map("linked_goal_id") @db.Uuid
  horizonDays    Int      @default(90) @map("horizon_days")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  keyResults CycleOkrKeyResult[]

  @@index([organizationId, cycleId])
  @@map("cycle_okrs")
}

model CycleOkrKeyResult {
  id           String   @id @default(uuid()) @db.Uuid
  okrId        String   @map("okr_id") @db.Uuid
  title        String
  targetValue  Float?   @map("target_value")
  currentValue Float?   @map("current_value")
  unit         String?
  done         Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  okr CycleOkr @relation(fields: [okrId], references: [id], onDelete: Cascade)

  @@index([okrId])
  @@map("cycle_okr_key_results")
}

model CycleClosure {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  cycleId           String   @unique @map("cycle_id") @db.Uuid
  targetValue       Float?   @map("target_value")
  resultValue       Float?   @map("result_value")
  targetLabel       String?  @map("target_label")
  recalibrateGoal   Boolean  @default(false) @map("recalibrate_goal")
  recalibrateReason String?  @map("recalibrate_reason")
  agendaAdherence   Json?    @map("agenda_adherence")
  radarSnapshot     Json?    @map("radar_snapshot")
  learnings         String?
  decision          String?
  coachSuggestion   String?  @map("coach_suggestion")
  coachResponse     String?  @map("coach_response")
  createdBy         String?  @map("created_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("cycle_closures")
}

model PdiSnapshot {
