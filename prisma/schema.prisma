  @@unique([roundId, evaluatorId])
  @@index([roundId])
  @@map("three_sixty_responses")
}

// ============================================================
// Pulsos — links públicos com token para o liderado responder
// (feedback solicitado, pulse de clima, DISC leve, pesquisa custom)
// ============================================================

enum PulseKind {
  feedback
  climate
  disc
  custom
  sabotadores
  cerebral
}

enum PulseSendStatus {
  pending
  answered
  expired
  revoked
}

model PulseTemplate {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @map("organization_id") @db.Uuid
  kind           PulseKind
  title          String
  intro          String?
  // schema of questions: [{ id, label, type: 'scale'|'text'|'choice'|'disc_pair', options?, required? }]
  questions      Json
  isSystem       Boolean   @default(false) @map("is_system")
  createdById    String?   @map("created_by_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  sends PulseSend[]

  @@index([organizationId, kind])
  @@map("pulse_templates")
}

model PulseSend {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  templateId     String          @map("template_id") @db.Uuid
  senderId       String          @map("sender_id") @db.Uuid
  subjectUserId  String?         @map("subject_user_id") @db.Uuid
  subjectLabel   String?         @map("subject_label")
  subjectPhone   String?         @map("subject_phone")
  token          String          @unique
  message        String? // custom message shown on the public page
  status         PulseSendStatus @default(pending)
  expiresAt      DateTime        @map("expires_at")
  answeredAt     DateTime?       @map("answered_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  template PulseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answer   PulseAnswer?

  @@index([organizationId, status])
  @@index([subjectUserId])
  @@map("pulse_sends")
}

model PulseAnswer {
  id           String   @id @default(uuid()) @db.Uuid
  sendId       String   @unique @map("send_id") @db.Uuid
  // answers: { [questionId]: value }  where value is number|string|string[]
  answers      Json
  // aiSummary: short text summarizing the answer set (auto-generated)
  aiSummary    String?  @map("ai_summary")
  // discProfile: { D, I, S, C } scores when kind=disc
  discProfile  Json?    @map("disc_profile")
  respondentIp String?  @map("respondent_ip")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  send PulseSend @relation(fields: [sendId], references: [id], onDelete: Cascade)

  @@map("pulse_answers")
}

// ============================================================
// Ciclos com metas SMART (Fase 1 · item 5)
// Um ciclo é um horizonte (trimestre, semestre) com metas ligadas a indicadores.
// ============================================================
enum CycleStatus {
  planning
  active
  closed
}

enum CycleGoalStatus {
  on_track
  at_risk
  off_track
  done
  dropped
}

enum GoalActionStatus {
  pending
  in_progress
  done
}

model Cycle {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  name           String
  startAt        DateTime    @map("start_at")
  endAt          DateTime    @map("end_at")
  status         CycleStatus @default(planning)
  summary        String?
  createdBy      String?     @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  goals CycleGoal[]

  @@index([organizationId, status])
  @@map("cycles")
}

model CycleGoal {
  id                 String          @id @default(uuid()) @db.Uuid
  cycleId            String          @map("cycle_id") @db.Uuid
  title              String
  specific           String?
  measurable         String?
  achievable         String?
  relevant           String?
  timeBound          String?         @map("time_bound")
  ownerUserId        String?         @map("owner_user_id") @db.Uuid
  areaId             String?         @map("area_id") @db.Uuid
  indicatorId        String?         @map("indicator_id") @db.Uuid
  targetValue        Float?          @map("target_value")
  currentValue       Float?          @map("current_value")
  dueAt              DateTime?       @map("due_at")
  neededIndicatorIds String[]        @default([]) @map("needed_indicator_ids")
  status             CycleGoalStatus @default(on_track)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  cycle         Cycle                    @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actionItems   CycleGoalActionItem[]
  breakdowns    CycleGoalBreakdown[]
  teamReadiness CycleGoalTeamReadiness[]
  cultureChecks CycleGoalCultureCheck[]
  reflections   CycleGoalReflection[]

  @@index([cycleId])
  @@index([indicatorId])
  @@map("cycle_goals")
}

// Plano de ação da meta ("Bater metas").
model CycleGoalActionItem {
  id          String           @id @default(uuid()) @db.Uuid
  goalId      String           @map("goal_id") @db.Uuid
  title       String
  description String?
  ownerUserId String?          @map("owner_user_id") @db.Uuid
  dueAt       DateTime?        @map("due_at")
  status      GoalActionStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  goal CycleGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("cycle_goal_action_items")
}

// Desdobramento da meta da equipe para cada colaborador.
model CycleGoalBreakdown {
  id           String          @id @default(uuid()) @db.Uuid
  goalId       String          @map("goal_id") @db.Uuid
  memberUserId String?         @map("member_user_id") @db.Uuid
  memberLabel  String?         @map("member_label")
  title        String
  indicatorId  String?         @map("indicator_id") @db.Uuid
  targetValue  Float?          @map("target_value")
  currentValue Float?          @map("current_value")
  dueAt        DateTime?       @map("due_at")
  status       CycleGoalStatus @default(on_track)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  goal CycleGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("cycle_goal_breakdowns")
}

// "Com o time": preparo da equipe para a meta, mês a mês.
model CycleGoalTeamReadiness {
  id          String   @id @default(uuid()) @db.Uuid
  goalId      String   @map("goal_id") @db.Uuid
  periodYear  Int      @map("period_year")
  periodMonth Int      @map("period_month")
  actions     String[] @default([])
  monthlyPlan String?  @map("monthly_plan")
  notes       String?
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  goal CycleGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, periodYear, periodMonth])
  @@index([goalId])
  @@map("cycle_goal_team_readiness")
}

// "Fazendo certo": coerência cultural da equipe em relação à meta.
model CycleGoalCultureCheck {
  id                         String   @id @default(uuid()) @db.Uuid
  goalId                     String   @map("goal_id") @db.Uuid
  practicesCulture           Int?     @map("practices_culture")
  highPerformanceOrientation Int?     @map("high_performance_orientation")
  factBasedDecisions         Int?     @map("fact_based_decisions")
  intellectualHonesty        Int?     @map("intellectual_honesty")
  behaviorsAlignment         Int?     @map("behaviors_alignment")
  notes                      String?
  createdBy                  String?  @map("created_by") @db.Uuid
  createdAt                  DateTime @default(now()) @map("created_at")

  goal CycleGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("cycle_goal_culture_checks")
}

// Perguntas de apoio — reflexão do líder sobre a meta.
model CycleGoalReflection {
  id        String   @id @default(uuid()) @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  promptKey String   @map("prompt_key")
  answer    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  goal CycleGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, promptKey])
  @@map("cycle_goal_reflections")
}

// ============================================================
// NR-1 — Diagnóstico de riscos psicossociais + canal de denúncia anônima
// ============================================================
enum NR1SurveyStatus {
  open
  closed
}

enum NR1ComplaintStatus {
  open
  in_review
  resolved
}

// Uma rodada de diagnóstico (link/QR único) para um time. Respostas são
// anônimas por design — nada aqui identifica o respondente.
model NR1Survey {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  teamId         String?         @map("team_id") @db.Uuid
  title          String
  token          String          @unique
  status         NR1SurveyStatus @default(open)
  actionPlan     String?         @map("action_plan")
  createdBy      String?         @map("created_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  closedAt       DateTime?       @map("closed_at")

  responses NR1Response[]

  @@index([organizationId])
  @@map("nr1_surveys")
}

model NR1Response {
  id           String   @id @default(uuid()) @db.Uuid
  surveyId     String   @map("survey_id") @db.Uuid
  answers      Json
  riskScore    Float?   @map("risk_score")
  respondentIp String?  @map("respondent_ip")
  createdAt    DateTime @default(now()) @map("created_at")

  survey NR1Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@map("nr1_responses")
}

// Link permanente por organização para denúncia anônima (não atrelado a
// nenhuma rodada de diagnóstico específica).
model NR1ComplaintChannel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @map("organization_id")
  token          String   @unique
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("nr1_complaint_channels")
}

model NR1Complaint {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  message        String
  category       String?
  status         NR1ComplaintStatus @default(open)
  respondentIp   String?            @map("respondent_ip")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("nr1_complaints")
}

// ============================================================
