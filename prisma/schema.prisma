  areaId         String?            @map("area_id") @db.Uuid
  teamId         String?            @map("team_id") @db.Uuid
  title          String
  description    String?
  assigneeId     String?            @map("assignee_id") @db.Uuid
  delegatorId    String?            @map("delegator_id") @db.Uuid
