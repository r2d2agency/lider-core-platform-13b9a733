model BaseNote {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  kind           String    @default("nota") // nota | reuniao
  title          String
  content        String    @default("")
  transcript     String?
  source         String    @default("manual") // manual | voz
  participants   String[]  @default([])
  tags           String[]  @default([])
  meetingAt      DateTime? @map("meeting_at")
