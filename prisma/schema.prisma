  version       Int                 @default(1)
  randomize     Boolean             @default(false)
  createdById   String?             @map("created_by") @db.Uuid
  updatedById   String?             @map("updated_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  blocks        AssessmentBlock[]
  versions      AssessmentVersion[]

  @@map("assessments_lib")
}

model AssessmentVersion {
  id           String     @id @default(uuid()) @db.Uuid
  assessmentId String     @map("assessment_id") @db.Uuid
  version      Int
  snapshot     Json
  authorId     String?    @map("author_id") @db.Uuid
  note         String?
  createdAt    DateTime   @default(now()) @map("created_at")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, version])
  @@map("assessment_versions")
}

model AssessmentBlock {
  id           String               @id @default(uuid()) @db.Uuid
  assessmentId String               @map("assessment_id") @db.Uuid
  title        String
  description  String?
  orderIndex   Int                  @default(0) @map("order_index")
  createdAt    DateTime             @default(now()) @map("created_at")
  assessment   Assessment           @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questions    AssessmentQuestion[]

  @@map("assessment_blocks")
}

model AssessmentQuestion {
  id         String                 @id @default(uuid()) @db.Uuid
  blockId    String                 @map("block_id") @db.Uuid
  type       AssessmentQuestionType
  prompt     String                 @db.Text
  helpText   String?                @map("help_text")
  required   Boolean                @default(true)
  weight     Int                    @default(1)
  scaleMin   Int?                   @map("scale_min")
  scaleMax   Int?                   @map("scale_max")
  showIf     Json?                  @map("show_if")
  orderIndex Int                    @default(0) @map("order_index")
  createdAt  DateTime               @default(now()) @map("created_at")
  block      AssessmentBlock        @relation(fields: [blockId], references: [id], onDelete: Cascade)
  options    AssessmentOption[]

  @@map("assessment_questions")
}

model AssessmentOption {
  id         String             @id @default(uuid()) @db.Uuid
  questionId String             @map("question_id") @db.Uuid
  label      String
  value      String
  score      Int                @default(0)
  orderIndex Int                @default(0) @map("order_index")
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("assessment_options")
}

model AssessmentShareLink {
  id           String                     @id @default(uuid()) @db.Uuid
  assessmentId String                     @map("assessment_id") @db.Uuid
  token        String                     @unique
  label        String?
  expiresAt    DateTime?                  @map("expires_at")
  maxResponses Int?                       @map("max_responses")
  revokedAt    DateTime?                  @map("revoked_at")
  createdById  String?                    @map("created_by") @db.Uuid
  createdAt    DateTime                   @default(now()) @map("created_at")
  responses    AssessmentPublicResponse[]

  @@index([assessmentId])
  @@map("assessment_share_links")
}

model AssessmentPublicResponse {
  id              String              @id @default(uuid()) @db.Uuid
  shareId         String              @map("share_id") @db.Uuid
  assessmentId    String              @map("assessment_id") @db.Uuid
  respondentName  String?             @map("respondent_name")
  respondentEmail String?             @map("respondent_email")
  answers         Json
  score           Json?
  submittedAt     DateTime            @default(now()) @map("submitted_at")
  share           AssessmentShareLink @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
  @@index([shareId])
  @@map("assessment_public_responses")
}

