  communicationStyle     String?         @map("communication_style")
  mbtiType               String?         @map("mbti_type")
  discPrimary            String?         @map("disc_primary")
  egogramaTraits         Json?           @map("egograma_traits")
  hardSelfScore          Int?            @map("hard_self_score")
  softSelfScore          Int?            @map("soft_self_score")
  heartSelfScore         Int?            @map("heart_self_score")
  riskFlags              String[]        @default([]) @map("risk_flags")
  strengths              String[]        @default([])
  notes                  String?
  assessmentAt           DateTime?       @map("assessment_at")
  // Módulo C — spec v2 (Julho 2026)
  activityDescription    String?         @map("activity_description")
  activityDescriptionUrl String?         @map("activity_description_url")
  activityDocName        String?         @map("activity_doc_name")
  activityDocText        String?         @map("activity_doc_text")
  activityDocAt          DateTime?       @map("activity_doc_at")
  coachCadence           CoachCadence    @default(weekly) @map("coach_cadence")
