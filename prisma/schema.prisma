  cerebralProfile        Json?           @map("cerebral_profile")
  cerebralPrimary        CerebralMode?   @map("cerebral_primary")
  qpScore                Int?            @map("qp_score")
  hardAnswers            Json?           @map("hard_answers")
  softAnswers            Json?           @map("soft_answers")
  heartAnswers           Json?           @map("heart_answers")
  discAnswers            Json?           @map("disc_answers")
  discProfile            Json?           @map("disc_profile")
  autoPdiId              String?         @map("auto_pdi_id") @db.Uuid
  autoPdiGeneratedAt     DateTime?       @map("auto_pdi_generated_at")
