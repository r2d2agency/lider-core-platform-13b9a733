model DelegationComment {
  id           String   @id @default(uuid()) @db.Uuid
  delegationId String   @map("delegation_id") @db.Uuid
  authorId     String?  @map("author_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at")

  delegation Delegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)

  @@index([delegationId])
  @@map("delegation_comments")
}

model Decision {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  ritualOccurrenceId String?        @map("ritual_occurrence_id") @db.Uuid
  title              String
  context            String?
  decision           String
